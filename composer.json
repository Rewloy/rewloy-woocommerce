{
    "name": "rewloy/rewloy-for-woocommerce",
    "description": "Rewloy for WooCommerce: paid orders fill Rewloy loyalty cards / Ödenen siparişler Rewloy sadakat kartlarını doldurur",
    "type": "wordpress-plugin",
    "license": "MIT",
    "homepage": "https://github.com/Rewloy/rewloy-woocommerce",
    "authors": [
        {
            "name": "Rewloy",
            "homepage": "https://rewloy.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Rewloy/rewloy-woocommerce/issues",
        "source": "https://github.com/Rewloy/rewloy-woocommerce",
        "docs": "https://rewloy.com/gelistiriciler",
        "security": "https://github.com/Rewloy/rewloy-woocommerce/security/policy"
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "php-stubs/woocommerce-stubs": "^9.0",
        "php-stubs/wordpress-stubs": "^6.4",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Rewloy\\WooCommerce\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.99"
        },
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "lint": "bin/lint",
        "analyse": "phpstan analyse --no-progress",
        "test": "phpunit",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "minimum-stability": "stable"
}

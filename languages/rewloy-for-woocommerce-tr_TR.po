msgstr "%1$s (istek: %2$s)"

#: src/Messages.php:110
msgid "Rewloy could not be reached or its answer could not be read. Try again in a moment."
msgstr "Rewloy'a ulaşılamadı ya da yanıtı okunamadı. Birazdan yeniden deneyin."

#: src/Messages.php:115
msgid "Rewloy did not accept this API key. Check that it is complete and has not been revoked."
msgstr "Rewloy bu API anahtarını kabul etmedi. Eksiksiz olduğunu ve iptal edilmediğini kontrol edin."

#: src/Messages.php:118
msgid "This API key is not allowed to do that. It needs the permissions to see cards and settings, to manage API keys and shop links, and to issue cards."
msgstr "Bu API anahtarının buna yetkisi yok. Kartları ve ayarları görme, API anahtarı ve mağaza bağlantısı yönetme ve kart verme yetkileri gerekir."

#: src/Messages.php:120
msgid "Shop links are not in this business's Rewloy plan."
msgstr "Mağaza bağlantısı bu işletmenin Rewloy planında yok."

#: src/Messages.php:122
msgid "At most 5 shops can be linked. Delete one in the Rewloy panel first."
msgstr "En fazla 5 mağaza bağlanabilir. Önce Rewloy panelinden birini silin."

#: src/Messages.php:124
msgid "That card was not found, or it is archived."
msgstr "Bu kart bulunamadı ya da arşivde."

#: src/Messages.php:126
msgid "Gift cards, coupons and discount cards are not filled by orders; they are given by code."
msgstr "Hediye kartı, kupon ve indirim kartı siparişle doldurulmaz; kodla verilir."

#: src/Messages.php:128
msgid "This link no longer exists in Rewloy."
msgstr "Bu bağlantı Rewloy'da artık yok."

#: src/Messages.php:130
msgid "Rewloy is receiving too many requests from this key. Try again in a minute."
msgstr "Rewloy bu anahtardan çok fazla istek alıyor. Bir dakika sonra yeniden deneyin."

#: src/Messages.php:133
msgid "This business's Rewloy account is read-only right now."
msgstr "Bu işletmenin Rewloy hesabı şu an salt okunur."

#: src/Messages.php:135
msgid "Rewloy did not accept the values sent."
msgstr "Rewloy gönderilen değerleri kabul etmedi."

#: src/Messages.php:137
msgid "Rewloy needs the statement that the customer was shown the privacy notice."
msgstr "Rewloy, müşteriye aydınlatma metninin sunulduğuna dair beyanı ister."

#: src/Messages.php:140
msgid "This e-mail address cannot be given a card by this business."
msgstr "Bu işletme bu e-posta adresine kart açamaz."

#: src/Messages.php:142
msgid "Rewloy did not accept the customer's details."
msgstr "Rewloy müşterinin bilgilerini kabul etmedi."

#: src/Messages.php:144
msgid "Rewloy refused to open the card."
msgstr "Rewloy kartı açmayı reddetti."

#: src/Messages.php:146 src/Messages.php:149
msgid "Rewloy had an error of its own. Try again in a moment."
msgstr "Rewloy'da bir hata oluştu. Birazdan yeniden deneyin."

#. translators: %s: the API's error code.
#: src/Messages.php:154
#, php-format
msgid "Rewloy refused the request (code %s)."
msgstr "Rewloy isteği reddetti (kod %s)."

#: src/Messages.php:155
msgid "Rewloy refused the request."
msgstr "Rewloy isteği reddetti."

#: src/Plugin.php:62
msgid "Rewloy for WooCommerce needs WooCommerce to be installed and active."
msgstr "Rewloy for WooCommerce'in çalışması için WooCommerce'in kurulu ve etkin olması gerekir."

msgstr "Bağlantı kapalıyken"

#: src/Messages.php:33
msgid "Other currency"
msgstr "Başka para birimi"

#: src/Messages.php:43
msgid "Added to the buyer's card."
msgstr "Alıcının kartına eklendi."

#: src/Messages.php:45
msgid "No customer of this card has the order's e-mail; no card was opened."
msgstr "Siparişteki e-postayla bu kartta müşteri yok; kart açılmadı."

#: src/Messages.php:47
msgid "The amount did not reach the rule's threshold; nothing was added."
msgstr "Tutar kuralın eşiğine ulaşmadı; eklenecek bir şey çıkmadı."

#: src/Messages.php:49
msgid "Arrived while the link was off; it was not processed and will not be later."
msgstr "Bağlantı kapalıyken geldi; işlenmedi, sonradan da işlenmez."

#: src/Messages.php:51
msgid "The order is not in the card's currency; the amount is not converted."
msgstr "Sipariş, kartın para biriminde değil; tutar çevrilmez."

#: src/Messages.php:60
msgid "Every paid order counts as one visit."
msgstr "Her ödenmiş sipariş bir ziyaret sayılır."

#: src/Messages.php:63
msgid "The card's own cashback rate is applied to the order total."
msgstr "Sipariş tutarına kartın kendi cashback oranı uygulanır."

